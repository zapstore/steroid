# steroid configuration. Copy to .env, which stays out of git.
# Inside the relay these come from the relay's environment instead.

# Required. The relay's data directory: relay.db is read, artifacts.db written.
DATA_DIR=../relay/data

# Required. OpenAI-compatible provider: API root, key, and model.
LLM_URL=
LLM_API_KEY=
# Comma-separated: the model, then fallbacks on the same provider.
LLM_MODEL=
# A second provider tried after the first fails. URL and key together, or neither.
LLM_FALLBACK_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Fetches an APK missing from DATA_DIR/blossom: GET /<sha256>.
# Default: https://cdn.zapstore.dev.
BLOSSOM_URL=
# The leaf-ir-v1 model, downloaded on first use. Default: DATA_DIR/models/leaf-ir-v1.
LEAF_MODEL_DIR=
# The ONNX Runtime library. Default: downloaded next to the model.
ONNXRUNTIME_LIB=
